}

function toggleRec(){
 var btn=$('recBtn');
 if(!isRec){
  canvas.width=stream.naturalWidth||640;canvas.height=stream.naturalHeight||480;ctx.drawImage(stream,0,0);
  var s=canvas.captureStream(25);recorder=new MediaRecorder(s,{mimeType:'video/webm'});chunks=[];
  recorder.ondataavailable=function(e){if(e.data.size>0)chunks.push(e.data)};
  recorder.onstop=function(){
   isRec=false;btn.textContent='REC';btn.classList.remove('rec-on');
   s.getTracks().forEach(function(track){track.stop()});
   if(!chunks.length){toast('无画面数据');return}
   var raw=new Blob(chunks,{type:'video/webm'}),elapsed=performance.now()-recStartedAt;
   patchWebmDuration(raw,elapsed).then(function(result){
    var url=URL.createObjectURL(result.blob),a=document.createElement('a');
    a.href=url;a.download='ecmv_video_'+Date.now()+'.webm';a.click();
    setTimeout(function(){URL.revokeObjectURL(url)},60000);
    if(!result.patched)toast('未找到 WebM 时长字段，已下载原始文件');
   }).catch(function(){
    var url=URL.createObjectURL(raw),a=document.createElement('a');
    a.href=url;a.download='ecmv_video_'+Date.now()+'.webm';a.click();
    setTimeout(function(){URL.revokeObjectURL(url)},60000);
    toast('时长修复失败，已下载原始文件');
   });
  };
  drawTimer=setInterval(function(){if(stream.readyState>=2)ctx.drawImage(stream,0,0,canvas.width,canvas.height)},40);
  recStartedAt=performance.now();recorder.start();isRec=true;btn.textContent='STOP';btn.classList.add('rec-on');
 }else{
  clearInterval(drawTimer);recorder.stop();
 }
}

